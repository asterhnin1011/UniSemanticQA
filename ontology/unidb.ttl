@prefix : <http://www.semanticweb.org/dell/ontologies/2026/7/untitled-ontology-19/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unisemantic: <http://example.org/unisemantic#> .
@base <http://www.semanticweb.org/dell/ontologies/2026/7/untitled-ontology-19/> .

<http://example.org/unisemantic#> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/unisemantic#enrolledIn
unisemantic:enrolledIn rdf:type owl:ObjectProperty .


###  http://example.org/unisemantic#isFromDept
unisemantic:isFromDept rdf:type owl:ObjectProperty .


###  http://example.org/unisemantic#specificMajor
unisemantic:specificMajor rdf:type owl:ObjectProperty .


###  http://example.org/unisemantic#teaches
unisemantic:teaches rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/unisemantic#hasCourseCode
unisemantic:hasCourseCode rdf:type owl:DatatypeProperty .


###  http://example.org/unisemantic#hasDescription
unisemantic:hasDescription rdf:type owl:DatatypeProperty .


###  http://example.org/unisemantic#hasEmail
unisemantic:hasEmail rdf:type owl:DatatypeProperty .


###  http://example.org/unisemantic#hasName
unisemantic:hasName rdf:type owl:DatatypeProperty .


###  http://example.org/unisemantic#hasStudentID
unisemantic:hasStudentID rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/unisemantic#Courses
unisemantic:Courses rdf:type owl:Class .


###  http://example.org/unisemantic#Departments
unisemantic:Departments rdf:type owl:Class .


###  http://example.org/unisemantic#Lecturers
unisemantic:Lecturers rdf:type owl:Class ;
                      rdfs:subClassOf unisemantic:Person .


###  http://example.org/unisemantic#Majors
unisemantic:Majors rdf:type owl:Class .


###  http://example.org/unisemantic#Person
unisemantic:Person rdf:type owl:Class .


###  http://example.org/unisemantic#Students
unisemantic:Students rdf:type owl:Class ;
                     rdfs:subClassOf unisemantic:Person .


#################################################################
#    Individuals
#################################################################

